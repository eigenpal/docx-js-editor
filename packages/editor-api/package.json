{
  "name": "@docx-editor.dev/editor-api",
  "version": "2.16.0",
  "description": "Document automation for DOCX: a batching object model that drives a document from a server or from an editor already open in a page",
  "sideEffects": false,
  "engines": {
    "node": "^20.16.0 || >=22.3.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/browser.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@docx-editor.dev/core": "workspace:*",
    "@microsoft/api-extractor": "^7.50.0",
    "fflate": "^0.8.2",
    "license-check-and-add": "^4.0.5"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/inject-package-doc.mjs --package @docx-editor.dev/editor-api",
    "typecheck": "tsc --noEmit",
    "license:check": "license-check-and-add check -f license-check.json",
    "license:add": "license-check-and-add add -f license-check.json",
    "api:extract": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/editor-api --local",
    "api:check": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/editor-api",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "compat:generate": "node scripts/generate-conformance.mjs",
    "compat:fetch-reference": "node scripts/fetch-office-reference.mjs",
    "compat:check-drift": "node scripts/fetch-office-reference.mjs --check",
    "compat:adopt": "node scripts/fetch-office-reference.mjs --adopt"
  },
  "keywords": [
    "docx",
    "word",
    "ooxml",
    "document",
    "automation",
    "headless"
  ],
  "author": {
    "name": "EigenPal, Inc.",
    "email": "licensing@eigenpal.com",
    "url": "https://eigenpal.com"
  },
  "license": "LicenseRef-EigenPal-Pro-Evaluation-1.0",
  "homepage": "https://docx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git",
    "directory": "packages/editor-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@docx-editor.dev/core": "~2.16.0"
  }
}
