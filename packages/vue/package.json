{
  "name": "@docx-editor.dev/vue",
  "version": "2.16.0",
  "description": "Vue 3 DOCX editor adapter for the @docx-editor.dev editor contract.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles/editor.css"
  },
  "files": [
    "dist",
    "src/styles",
    "!dist/metafile-*.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "api:extract": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/vue --local",
    "api:check": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/vue"
  },
  "peerDependencies": {
    "@docx-editor.dev/core": "~2.16.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@docx-editor.dev/core": "workspace:*",
    "fflate": "^0.8.2",
    "vue": "^3.5.29"
  },
  "dependencies": {
    "@docx-editor.dev/i18n": "^2.16.0"
  },
  "keywords": [
    "docx",
    "editor",
    "vue",
    "word",
    "document"
  ],
  "author": {
    "name": "Jedr Blaszyk",
    "email": "jedr@eigenpal.com",
    "url": "https://github.com/jedrazb"
  },
  "license": "Apache-2.0",
  "homepage": "https://docx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
