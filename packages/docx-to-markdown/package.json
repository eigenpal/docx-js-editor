{
  "name": "@docx-editor.dev/docx-to-markdown",
  "version": "2.14.0",
  "private": true,
  "description": "Server-first DOCX to Markdown conversion powered by the shared docx-editor.dev semantic layout engine.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.16.0 || >=22.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "api:extract": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/docx-to-markdown --local",
    "api:check": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/docx-to-markdown"
  },
  "peerDependencies": {
    "@docx-editor.dev/core": "~2.16.0"
  },
  "dependencies": {
    "@docx-editor.dev/fonts": "~2.16.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.3",
    "@docx-editor.dev/core": "workspace:*",
    "fflate": "^0.8.2",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "docx",
    "markdown",
    "converter",
    "headless"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git",
    "directory": "packages/docx-to-markdown"
  }
}
